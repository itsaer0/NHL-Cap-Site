<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/main.css">
    <title>Be a GM!</title>
</head>
<body>
    <%- include('./partials/navbar', {page: '/beagm'}) %>
    <main class="max-w-6xl mx-auto p-6">
        <h1 class="text-3xl font-bold text-center mb-6">Choose a Team to Manage</h1>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            <% teams.forEach(team => { %>
                <div class="bg-white p-4 rounded-lg shadow-lg flex flex-col items-center">
                    <img src="<%= team.imageURL %>" alt="<%= team.name %> Logo" class="w-32 h-32 mb-4">
                    <h2 class="text-xl font-semibold text-gray-600 mb-2"><strong><%= team.name %></strong></h2>
                    <p class="text-gray-600 mb-2"><strong>City:</strong> <%= team.city %></p>
                    <p class="text-gray-600 mb-2"><strong>Arena:</strong> <%= team.arena %></p>
                    <p class="text-gray-600 mb-2"><strong>Conference:</strong> <%= team.conference %></p>
                    <p class="text-gray-600 mb-2"><strong>Division:</strong> <%= team.division %></p>
                    <a href="/beagm/<%= team.id %>" class="mt-auto btn-select-team">Select Team</a>
                </div>
            <% }); %> 
        </div>
    </main>
    
    
</body>
</html>