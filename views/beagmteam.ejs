<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/main.css">
    <title>Be a GM! - <%= team.name %></title>
</head>
<body>
    <%- include('./partials/navbar', {page: '/beagm/team.id'}) %>

    <!-- Hero Section -->
    <section class="hero bg-gray-100 p-6 mb-6">
        <div class="max-w-6xl mx-auto flex flex-col items-center text-center">
            <img src="<%= team.imageURL %>" alt="<%= team.name %> Logo" class="w-32 h-32 mb-4 object-contain">
            <h1 class="text-4xl font-bold mb-2"><%= team.name %></h1>
            <p class="text-xl mb-2"><strong>City:</strong> <%= team.city %></p>
            <p class="text-xl mb-2"><strong>Arena:</strong> <%= team.arena %></p>
            <p class="text-xl mb-2"><strong>Salary Cap:</strong> $<%= team.currentcaphit %></p>
            <p class="text-xl mb-2"><strong>Roster Size:</strong> <%= team.rostersize %> players</p>
        </div>
    </section>

    <!-- Players Grid -->
    <section class="players-grid max-w-6xl mx-auto p-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            <% players.forEach(player => { %>
                <div class="bg-white p-4 rounded-lg shadow-lg flex flex-col items-center">
                    <h2 class="text-xl text-gray-600 font-semibold mb-2"><%= player.name %></h2>
                    <p class="text-gray-600 mb-2"><strong>Position:</strong> <%= player.positions %></p>
                    <p class="text-gray-600 mb-2"><strong>Age:</strong> <%= player.age %></p>
                    <p class="text-gray-600 mb-2"><strong>Salary:</strong> <%= player.currentcaphit %></p>
                </div>
            <% }); %>
        </div>
    </section>
</body>
</html>