<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/main.css">
    <title><%= player.name %> - Stats & Info</title>
</head>
<body class="bg-gray-100 container mx-auto">
    <%- include('./partials/navbar', {page: '/players/player.id'}) %>
    <div class="hero h-1/5 bg-base-200 mb-5">
        <div class="text-center hero-content">
            <div class="max-w-md">
                <h1 class="mb-5 text-5xl font-bold"><%= player.name %></h1>
                <p class="mb-5"><%= player.name %> is a [Forward, Defenseman, Goalie] for the <%= player.currentteam %>.</p>
            </div>
        </div>
    </div>
    <div class="container mx-auto p-6">
        <div class="bg-white p-6 rounded-lg shadow-lg">
            <p><strong>Age:</strong> <%= player.age %></p>
            <p><strong>Birthdate:</strong> <%= player.birthdate %></p>
            <p><strong>Height (cm):</strong><%= player.height %></p>
            <p><strong>Weight (kg):</strong> <%= player.weight %></p>
            <p><strong>Birthplace:</strong> <%= player.birthplace %></p>
            <p><strong>Nationality:</strong> <%= player.nationality %></p>
            <p><strong>Draft Year:</strong> <%= player.draftyear %></p>
            <p><strong>Draft Position:</strong> <%= player.draftposition %></p>
            <p><strong>Draft Round:</strong> <%= player.draftround %></p>
            <p><strong>Draft Team:</strong> <%= player.draftteam %></p>
            <p><strong>Current Team</strong> <%= player.currentteam %></p>
            <p><strong>Position(s):</strong> <%= player.positions %></p>
            <p><strong>Shoots:</strong> <%= player.handedness %></p>
            <p><strong>Salary:</strong> <%= player.currentcaphit %></p>
            <p><strong>Captain?</strong> <%= player.captain %></p>
            <p><strong>Alternate Captain?</strong> <%= player.alternatecaptain %></p>
            <p><strong>Active?</strong> <%= player.active %></p>
            <p><strong>Injured Reserve?</strong> <%= player.injuredreserve %></p>
            <p><strong>Long Term Injured Reserve?</strong> <%= player.longterminjuredreserve %></p>
            
        </div>
    </div>
</body>
</html>